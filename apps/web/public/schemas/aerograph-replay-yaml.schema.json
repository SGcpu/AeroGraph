{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schema.aerograph.dev/replay-policy/v1.json",
  "title": "AeroGraphReplayPolicy",
  "description": "Tool safety policy schema for aerograph.replay.yaml",
  "type": "object",
  "properties": {
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["match", "class"],
        "properties": {
          "match": {
            "type": "string",
            "minLength": 1,
            "description": "Glob pattern matched against URL"
          },
          "toolName": {
            "type": "string",
            "description": "Optional tool name matcher"
          },
          "class": {
            "type": "string",
            "enum": ["replay_safe", "must_execute"],
            "description": "Safety classification for replay"
          }
        },
        "additionalProperties": false
      }
    },
    "normalization": {
      "type": "object",
      "description": "Transient token masking and header stripping rules for deterministic hashing",
      "properties": {
        "strip_headers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mask_json_keys": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mask_regexes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pattern"],
            "properties": {
              "pattern": { "type": "string", "minLength": 1 },
              "replace": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
